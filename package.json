{
  "name": "qn-chrome-tabs",
  "version": "1.0.0",
  "description": "零框架依赖的 Chrome 风格标签栏 Web Component",
  "keywords": [
    "web-component",
    "tabs",
    "chrome-tabs",
    "framework-agnostic",
    "micro-frontend"
  ],
  "homepage": "https://qlynick.github.io/qn-chrome-tabs/",
  "bugs": {
    "url": "https://github.com/qlynick/qn-chrome-tabs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qlynick/qn-chrome-tabs.git"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/qn-chrome-tabs.js"
    }
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
