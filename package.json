{
  "name": "qn-chrome-tabs",
  "version": "0.1.0",
  "description": "零框架依赖的 Chrome 风格标签栏 Web Component",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/qn-chrome-tabs.js"
    }
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.json",
    "build:demo": "vite build --config demo/vite.config.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
